---
import Base from '../../layouts/Base.astro';
import { zichtbareRecepten } from '../../lib/recepten';

export async function getStaticPaths() {
  const recepten = await zichtbareRecepten();
  return recepten.map((r) => ({ params: { slug: r.slug }, props: { recept: r } }));
}
const { recept } = Astro.props;
const d = recept.data;
const { Content } = await recept.render();
const labels: Record<string, string> = { hedwin: 'van papa hedwin', frank: 'van frank', oma: 'van oma brigitte', gilles: 'van gilles', samen: 'van ons tweeën' };
const auteur = d.familie === 'gilles' ? 'Gilles' : 'Florry Kindt';
const stappen = recept.body.split('\n').filter((l) => /^\d+\./.test(l.trim())).map((l) => l.replace(/^\d+\.\s*/, '').trim());

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Recipe',
    name: d.titel,
    description: d.beschrijving,
    author: { '@type': 'Person', name: auteur },
    datePublished: d.datum.toISOString().slice(0, 10),
    recipeYield: `${d.porties} personen`,
    prepTime: `PT${d.voorbereiding}M`,
    cookTime: `PT${d.bereiding}M`,
    totalTime: `PT${d.voorbereiding + d.bereiding}M`,
    ...(d.foto ? { image: [new URL(d.foto, Astro.site).toString()] } : {}),
    recipeCategory: d.categorie,
    recipeCuisine: 'Belgisch',
    recipeIngredient: d.ingredienten,
    recipeInstructions: stappen.map((s) => ({ '@type': 'HowToStep', text: s })),
  },
  ...(d.faq.length ? [{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.vraag, acceptedAnswer: { '@type': 'Answer', text: f.antwoord } })),
  }] : []),
];
const tijd = (m: number) => (m >= 60 ? `${Math.floor(m / 60)} u ${m % 60 ? (m % 60) + ' min' : ''}` : `${m} min`);
---
<Base title={`${d.titel.charAt(0).toUpperCase() + d.titel.slice(1)}: recept`} description={d.beschrijving} schema={schema} image={d.foto}>
  <article>
    <header class="recept-kop smal">
      {d.familie && <span class="kicker">{labels[d.familie]}</span>}
      <h1><span class="lijn"><span>{d.titel}</span></span></h1>
      <span class="slash">{d.slash}</span>
      <p style="margin-top:20px">{d.beschrijving}</p>
      <div class="recept-meta">
        <div><b>personen</b>{d.porties}</div>
        <div><b>voorbereiding</b>{tijd(d.voorbereiding)}</div>
        {d.bereiding > 0 && <div><b>bereiding</b>{tijd(d.bereiding)}</div>}
        <div><b>gang</b>{d.categorie}</div>
      </div>
    </header>

    <div class="wrap"><div class="foto foto--breed reveal-foto">{d.foto ? <img src={d.foto} alt={d.titel} /> : <div class="ph"><i class="o-mark"></i><span>foto volgt</span></div>}</div></div>

    <div class="wrap recept-body">
      <aside class="ingredienten">
        <h3>ingrediënten</h3>
        <ul>{d.ingredienten.map((i) => <li>{i}</li>)}</ul>
      </aside>
      <div class="stappen">
        {d.concept && <p class="concept-melding">Concepttekst. Vervang door het echte familierecept voor publicatie.</p>}
        <blockquote class="verhaal-blok">{d.verhaal}</blockquote>
        <h2>bereiding</h2>
        <Content />

        {d.faq.length > 0 && (
          <section class="faq" style="margin-top:48px">
            <h2>vragen over dit recept</h2>
            {d.faq.map((f) => <details><summary>{f.vraag}</summary><p>{f.antwoord}</p></details>)}
          </section>
        )}

        <div class="cta-kader">
          <h3>Liever dat wij dit voor jou koken?</h3>
          <p>Ode komt aan huis koken voor 6 tot 12 gasten in Oost en West-Vlaanderen.</p>
          <a class="knop" href="/aan-tafel/">Vraag je datum aan</a>
        </div>
        <p style="margin-top:32px;font-style:italic;color:var(--zacht)">Recept van {auteur}, Ode Cuisine. <a href="/kookboek/">Dit recept komt ook in het Ode kookboek.</a></p>
      </div>
    </div>
  </article>
</Base>
