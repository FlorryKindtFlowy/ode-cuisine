---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { kerstmenu, gangen } from '../lib/kerstmenu';

// Kerst met Ode: bezoekers stellen zelf hun kerstmenu samen en downloaden een menukaartje (PDF).
// De gerechten en recepten staan in src/lib/kerstmenu.ts.
const recepten = await getCollection('recepten');
const nu = new Date();
const toonAlles = import.meta.env.DEV || import.meta.env.PUBLIC_TOON_ALLES === 'true';

// Link naar het recept, enkel als het voor klanten zichtbaar mag zijn.
const linkVoor = (g: (typeof kerstmenu)[number]): string | null => {
  if (!g.zichtbaar && !toonAlles) return null;
  if (g.recept) {
    const r = recepten.find((x) => x.slug === g.recept);
    return r && (toonAlles || r.data.datum <= nu || r.data.vroegLive) ? `/recepten/${g.recept}/` : null;
  }
  return g.stappen ? `/kerst/recept/${g.slug}/` : null;
};

// Foto: eigen kerstfoto, anders de foto van het gekoppelde zondagsrecept.
const fotoVoor = (g: (typeof kerstmenu)[number]) => {
  if (g.foto) return { foto: g.foto, fotoAlt: g.fotoAlt };
  const r = g.recept ? recepten.find((x) => x.slug === g.recept) : undefined;
  return { foto: r?.data.foto, fotoAlt: r?.data.fotoAlt };
};
const perGang = gangen.map((x) => ({ ...x, items: kerstmenu.filter((g) => g.gang === x.gang).map((g) => ({ ...g, ...fotoVoor(g), link: linkVoor(g) })) }));
const kaartData = {
  gangen: gangen.map((x) => x.gang),
  items: kerstmenu.map((g) => ({ slug: g.slug, titel: g.titel, slash: g.slash, gang: g.gang })),
};

const faq = [
  { vraag: 'Hoe werkt Kerst met Ode?', antwoord: 'Je klikt op de kerstkaart de gerechten aan die je wil maken: hapjes, voorgerechten, hoofdgerechten, desserts en iets bij de koffie. Je keuze verschijnt meteen op een menukaartje. Geef het een titel, zoals kerstavond bij jou thuis, en download het als PDF om af te drukken voor op tafel.' },
  { vraag: 'Hoeveel hapjes reken je per persoon?', antwoord: 'Als aperitief voor een diner reken je vier tot zes hapjes per persoon. Wordt de apero de hele avond, dan mag dat tien tot twaalf zijn. Kies dan liever minder soorten en maak er meer van.' },
  { vraag: 'Wat kan je op voorhand maken voor een kerstmenu?', antwoord: 'Meer dan je denkt. Stoofgerechten zoals konijn met pruimen, hertenstoverij of varkenswangetjes maak je een of twee dagen op voorhand en ze worden er alleen maar beter van. Kroketjes en gougères kunnen in de diepvriezer, desserts zoals tiramisu en kerststronk maak je de dag ervoor. Bij elk recept staat wat je op voorhand kan doen.' },
  { vraag: 'Hoe druk ik het menukaartje af?', antwoord: 'Het menukaartje is een PDF op A5, de helft van een gewoon A4 blad. Druk af op stevig papier van 250 tot 300 gram, met de instelling werkelijke grootte. Op A4 drukken kan ook, dan zet je het kaartje in een fotolijstje of op een standaardje.' },
  { vraag: 'Krijg ik de recepten ook in mijn mailbox?', antwoord: 'Binnenkort wel. Dan krijg je bij het downloaden van je menukaartje ook alle recepten van je gekozen gerechten in je mailbox. Wil je nu al elke zondag een recept ontvangen, schrijf je dan in voor Ode Zondag.' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Kerst met Ode: stel je eigen kerstmenu samen',
    description: 'Kies uit 20 hapjes, 5 voorgerechten, 5 hoofdgerechten, 7 desserts en 3 versnaperingen bij de koffie, en download je eigen menukaartje voor op tafel.',
    url: 'https://www.odecuisine.be/kerst/',
    inLanguage: 'nl-BE',
    author: { '@type': 'Person', name: 'Florry Kindt' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.vraag, acceptedAnswer: { '@type': 'Answer', text: f.antwoord } })),
  },
];
---
<Base
  title="Stel je eigen kerstmenu samen · Kerst met Ode"
  rawTitle={true}
  description="Kies je kerstmenu uit 20 hapjes, 5 voorgerechten, 5 hoofdgerechten, 7 desserts en iets bij de koffie. Download je eigen menukaartje en druk het af voor op tafel."
  schema={schema}
  image="/fotos/kerst/kersttafel.webp"
>
  <!-- HERO -->
  <section class="sectie sectie--wijn kerst-hero kerst-bg" data-kleur="wijn">
    <div class="wrap twee">
      <div>
        <span class="kicker">Kerst met Ode · stel je eigen menu samen</span>
        <h1><span class="lijn"><span>Kerst met <em>Ode</em></span></span></h1>
        <p class="lead">Geen vast menu, maar een kaart vol klassiekers. Jij kiest wat er op jouw tafel komt, en je krijgt er een menukaartje bij om af te drukken.</p>
        <p>Kerst is de avond waarop je het gemis het felst voelt. Er blijft een stoel leeg, of je zet er net eentje bij. En toch zitten we die avond het dichtst bij elkaar, rond gerechten die iemand ons ooit leerde.</p>
        <p>Daarom zette ik twintig hapjes, vijf voorgerechten, vijf hoofdgerechten, zeven desserts en drie versnaperingen bij de koffie op een kaart. Kies, combineer en maak er jouw avond van.</p>
        <div class="knoppen" style="margin-top:28px">
          <a class="knop knop--vol" href="#kaart">Kies je gerechten <span class="pijl">→</span></a>
        </div>
      </div>
      <figure class="kerst-foto">
        <div class="kerst-lijst">
          <div class="foto foto--boog reveal-foto"><img src="/fotos/kerst/kersttafel.webp" srcset="/fotos/kerst/kersttafel-klein.webp 600w, /fotos/kerst/kersttafel.webp 1024w" sizes="(max-width: 900px) 100vw, 50vw" alt="Gedekte kersttafel met oesters op ijs, bruschetta, gevulde dadels, kaarsen en glazen bubbels" loading="eager" style="object-position:50% 45%" /></div>
        </div>
        <img class="kerst-slinger" src="/fotos/kerst/slinger.webp" srcset="/fotos/kerst/slinger-klein.webp 800w, /fotos/kerst/slinger.webp 1567w" sizes="(max-width: 900px) 110vw, 55vw" alt="" aria-hidden="true" loading="eager" />
        <img class="kerst-strik" src="/fotos/kerst/strik.webp" alt="" aria-hidden="true" loading="eager" />
      </figure>
    </div>
  </section>

  <!-- DE KAART -->
  <section class="sectie sectie--wijn kk kerst-bg" id="kaart" data-kleur="wijn">
    <div class="wrap">
      <div class="kk-intro">
        <span class="kicker">de kerstkaart</span>
        <h2>Wat komt er op <em>jouw</em> tafel?</h2>
        <p>Klik de gerechten aan die je wil maken. Ze verschijnen meteen op je menukaartje. Geef het een titel en download het om af te drukken.</p>
      </div>

      <div class="kk-raam">
        <div class="kk-keuze">
          {perGang.map((x) => (
            <div class="kk-gang" data-gang={x.gang}>
              <header class="kk-gang-kop">
                <h3>{x.label}</h3>
                <p>{x.uitleg}</p>
                <span class="kk-aantal" data-aantal={x.gang}></span>
              </header>
              <div class="kk-raster">
                {x.items.map((g) => (
                  <div class="kk-item">
                    <label class="kk-kies">
                      <input type="checkbox" value={g.slug} />
                      <span class="kk-foto">
                        {g.foto
                          ? <img src={g.foto} alt={g.fotoAlt ?? g.titel} loading="lazy" />
                          : <span class="ph"><i class="o-mark"></i></span>}
                        <span class="kk-vink" aria-hidden="true"></span>
                      </span>
                      <span class="kk-t">{g.titel}</span>
                      <span class="kk-s">{g.slash}</span>
                    </label>
                    {g.link ? <a class="kk-recept" href={g.link}>recept <span aria-hidden="true">→</span></a> : <span class="kk-volgt">recept volgt</span>}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

        <aside class="kk-zij" id="kaartje">
          <div class="kk-kaartje">
            <canvas id="kk-doek" width="874" height="1240" aria-hidden="true"></canvas>
            <div class="kk-sr" aria-live="polite">
              <p id="kk-titel">een ode aan kerst</p>
              <p id="kk-datum"></p>
              <div id="kk-lijst">
                <p class="kk-leeg">Klik gerechten aan op de kaart. Ze verschijnen hier.</p>
              </div>
            </div>
          </div>
          <div class="kk-velden">
            <label for="kk-naam">Titel op je kaartje</label>
            <input id="kk-naam" type="text" maxlength="40" placeholder="kerstavond bij Lien" autocomplete="off" />
            <label for="kk-dag">Datum (mag leeg)</label>
            <input id="kk-dag" type="text" maxlength="30" placeholder="24 december 2026" autocomplete="off" />
          </div>
          <button type="button" class="knop knop--vol kk-download" id="kk-download" disabled>Download je menukaartje <span class="pijl">→</span></button>
          <p class="kk-klein">PDF op A5, klaar om af te drukken. Binnenkort krijg je er ook alle recepten bij in je mailbox.</p>
          <button type="button" class="kk-wis" id="kk-wis">alles wissen</button>
        </aside>
      </div>
    </div>
    <a class="kk-balk" href="#kaartje" hidden><span id="kk-teller">0 gerechten</span><span>bekijk je kaartje →</span></a>
    <script type="application/json" id="kk-data" set:html={JSON.stringify(kaartData)} />
  </section>

  <!-- OP VOORHAND -->
  <section class="sectie" data-kleur="zand">
    <div class="smal">
      <span class="kicker">op voorhand</span>
      <h2>Zodat jij aan tafel <em>zit</em></h2>
      <p>Kerst is geen avond om in de keuken te staan. Een paar vuistregels voor je kiest:</p>
      <ul class="kk-regels">
        <li>Kies één stoofgerecht. Konijn met pruimen, hertenstoverij en varkenswangetjes maak je een of twee dagen op voorhand, en ze worden er alleen maar beter van.</li>
        <li>Mix koude en warme hapjes. Hespenrolletjes, witloofbootjes en carpaccio rolletjes staan klaar in de koelkast, zodat je maar een paar dingen moet bakken of frituren.</li>
        <li>Kroketjes, gougères en bitterballen kunnen weken op voorhand in de diepvriezer.</li>
        <li>Kies een dessert dat de dag ervoor kan, zoals tiramisu van oma of de kerststronk. Sabayon en crêpe suzette zijn voor wie graag een moment aan tafel maakt.</li>
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="sectie sectie--room" data-kleur="room">
    <div class="smal">
      <span class="kicker">vragen over kerst</span>
      <h2>Wat je je misschien <em>afvraagt</em></h2>
      <div class="faq">
        {faq.map((f) => <details><summary>{f.vraag}</summary><p>{f.antwoord}</p></details>)}
      </div>
    </div>
  </section>

  <!-- ODE AAN -->
  <section class="sectie sectie--wijn" data-kleur="wijn">
    <div class="smal centraal">
      <span class="kicker">ode aan</span>
      <h2>Welk gerecht hoort bij <em>jouw</em> Kerst?</h2>
      <p>De kalkoen van je meter, het dessert dat je opa elk jaar maakte, de hapjes van je mama. Deel het recept en het verhaal erachter, dan brengen we er samen een ode aan.</p>
      <a class="knop" href="/ode-aan/#inzenden">Deel jouw kerstrecept</a>
    </div>
  </section>

  <style>
    /* Kerstsfeer: diep bordeaux met zachte gloed, goud en room zoals het menukaartje */
    .kerst-hero, .kk { --k-room: #f4eee6; --k-goud: #c4a06a; --k-goud-diep: #b08d57; --k-zacht: rgba(244, 238, 230, .68); --k-lijn: rgba(196, 160, 106, .45); color: var(--k-room); }
    .kerst-bg { overflow: hidden; isolation: isolate; }
    .kerst-bg::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
      background: radial-gradient(ellipse 80% 60% at 50% 20%, rgba(110, 24, 36, .55), transparent 70%), radial-gradient(ellipse 120% 90% at 50% 110%, rgba(20, 3, 7, .6), transparent 60%); }
    .kerst-hero .kicker, .kk .kicker { color: var(--k-goud); }
    .kerst-hero h1, .kk h2, .kk h3 { color: var(--k-room); }
    .kerst-hero h1 em, .kk h2 em { color: var(--k-goud); }
    .kerst-hero .knop--vol, .kk .knop--vol { background: var(--k-room); border-color: var(--k-room); color: var(--wijn); }
    .kerst-hero .knop--vol::before, .kk .knop--vol::before { background: var(--k-goud-diep); }
    .kerst-hero .knop--vol:hover, .kk .knop--vol:hover { color: var(--k-room); border-color: var(--k-goud-diep); }

    .kerst-hero { padding-top: clamp(130px, 14vw, 190px); }
    .kerst-hero h1 { font-size: clamp(3rem, 7vw, 6rem); font-weight: 300; }
    .kerst-hero .lead { color: var(--k-room); }
    .kerst-hero p { color: var(--k-zacht); }

    /* Foto in een boog met dennenslinger en strik, zoals op het kaartje */
    .kerst-foto { margin: 0; position: relative; width: min(100%, 470px); justify-self: center; margin-top: 8%; }
    .kerst-lijst { position: relative; background: var(--k-room); padding: 14px; border-radius: 999px 999px 0 0; box-shadow: 14px 14px 0 #1a0408, 0 40px 80px -30px rgba(0, 0, 0, .6); }
    .kerst-lijst::after { content: ''; position: absolute; inset: 7px; border: 1.5px solid var(--k-goud-diep); border-radius: 999px 999px 0 0; pointer-events: none; }
    .kerst-lijst .foto { position: relative; z-index: 1; }
    .kerst-slinger { position: absolute; left: -9.15%; top: -8.3%; width: 117.7%; max-width: none; height: auto; pointer-events: none; z-index: 2; filter: drop-shadow(0 6px 8px rgba(0, 0, 0, .3)); }
    .kerst-strik { position: absolute; left: 34.2%; top: -6.25%; width: 31.5%; height: auto; pointer-events: none; z-index: 3; filter: drop-shadow(0 6px 10px rgba(0, 0, 0, .35)); }

    .kk-intro { max-width: 640px; margin-bottom: 56px; }
    .kk-intro p { color: var(--k-zacht); }
    .kk-raam { display: grid; grid-template-columns: minmax(0, 1fr) 400px; gap: 56px; align-items: start; }
    .kk-gang + .kk-gang { margin-top: 64px; }
    .kk-gang-kop { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 4px 16px; border-bottom: 1px solid var(--k-lijn); padding-bottom: 14px; margin-bottom: 26px; }
    .kk-gang-kop h3 { margin: 0; font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 300; }
    .kk-gang-kop p { grid-column: 1; margin: 0; font-family: var(--serif); font-style: italic; color: var(--k-zacht); font-size: 1.1rem; }
    .kk-aantal { grid-column: 2; grid-row: 1 / span 2; align-self: center; font-size: .68rem; letter-spacing: .22em; text-transform: uppercase; color: var(--k-goud); }
    .kk-raster { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px 20px; }
    .kk-item { display: flex; flex-direction: column; }
    .kk-kies { cursor: pointer; display: flex; flex-direction: column; }
    .kk-kies input { position: absolute; opacity: 0; pointer-events: none; }
    .kk-foto { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; background: rgba(255, 255, 255, .05); margin-bottom: 14px; border-radius: 999px 999px 0 0; outline: 1px solid transparent; outline-offset: 5px; transition: outline-color .3s; }
    .kk-foto img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease); }
    .kk-foto .ph { background: rgba(255, 255, 255, .06); color: var(--k-goud); }
    .kk-kies:hover .kk-foto img { transform: scale(1.05); }
    .kk-vink { position: absolute; bottom: 12px; right: 50%; transform: translateX(50%); width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--k-room); background: rgba(42, 10, 16, .45); backdrop-filter: blur(4px); transition: background .3s, border-color .3s; }
    .kk-vink::after { content: ''; position: absolute; left: 11px; top: 6px; width: 7px; height: 13px; border: solid var(--wijn); border-width: 0 2px 2px 0; transform: rotate(45deg); opacity: 0; }
    .kk-kies input:checked + .kk-foto { outline-color: var(--k-goud); }
    .kk-kies input:checked + .kk-foto .kk-vink { background: var(--k-goud); border-color: var(--k-goud); }
    .kk-kies input:checked + .kk-foto .kk-vink::after { opacity: 1; }
    .kk-kies input:focus-visible + .kk-foto { outline: 2px solid var(--k-goud); }
    .kk-t { font-family: var(--serif); font-size: 1.35rem; line-height: 1.15; color: var(--k-room); transition: color .3s; }
    .kk-kies input:checked ~ .kk-t { color: var(--k-goud); font-style: italic; }
    .kk-s { font-family: var(--serif); font-style: italic; color: var(--k-zacht); font-size: 1rem; margin-top: 2px; }
    .kk-recept, .kk-volgt { margin-top: 8px; font-size: .66rem; letter-spacing: .22em; text-transform: uppercase; }
    .kk-recept { color: var(--k-goud); text-decoration: none; }
    .kk-recept:hover { text-decoration: underline; }
    .kk-volgt { color: var(--k-zacht); opacity: .7; }

    .kk-zij { position: sticky; top: 96px; }
    .kk-kaartje { position: relative; box-shadow: 0 40px 80px -30px rgba(0, 0, 0, .7), 0 0 0 1px rgba(196, 160, 106, .25); line-height: 0; }
    .kk-kaartje canvas { display: block; width: 100%; height: auto; aspect-ratio: 1748 / 2480; background: #430d16; }
    .kk-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .kk-velden { margin-top: 26px; display: grid; gap: 6px; }
    .kk-velden label { font-size: .66rem; letter-spacing: .22em; text-transform: uppercase; color: var(--k-goud); margin-top: 8px; }
    .kk-velden input { font: inherit; font-family: var(--serif); font-size: 1.15rem; padding: 10px 12px; border: 1px solid var(--k-lijn); background: rgba(255, 255, 255, .05); color: var(--k-room); }
    .kk-velden input::placeholder { color: rgba(244, 238, 230, .4); }
    .kk-velden input:focus { outline: 1px solid var(--k-goud); }
    .kk-download { width: 100%; justify-content: center; margin-top: 22px; }
    .kk-download[disabled] { opacity: .45; cursor: not-allowed; }
    .kk-klein { font-size: .85rem; color: var(--k-zacht); margin: 12px 0 0; }
    .kk-wis { background: none; border: 0; padding: 0; margin-top: 10px; font: inherit; font-size: .66rem; letter-spacing: .22em; text-transform: uppercase; color: var(--k-zacht); cursor: pointer; text-decoration: underline; }
    .kk-balk { display: none; }

    .kk-regels { margin: 24px 0 0; padding-left: 20px; }
    .kk-regels li { margin-bottom: 12px; }

    @media (max-width: 1100px) {
      .kk-raam { grid-template-columns: minmax(0, 1fr) 330px; gap: 36px; }
      .kk-raster { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 900px) {
      .kerst-hero .twee { grid-template-columns: 1fr; }
      .kerst-foto { width: min(84%, 420px); margin-top: 12%; }
      .kk-raam { grid-template-columns: 1fr; }
      .kk-zij { position: static; max-width: 440px; margin: 0 auto; width: 100%; }
      .kk-balk:not([hidden]) { display: flex; position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 50; justify-content: space-between; gap: 12px; padding: 14px 20px; background: #f4eee6; color: var(--wijn); text-decoration: none; font-size: .7rem; letter-spacing: .2em; text-transform: uppercase; border-radius: 999px; box-shadow: 0 12px 30px -10px rgba(0, 0, 0, .6); }
    }
    @media (max-width: 480px) {
      .kk-raster { gap: 22px 14px; }
      .kk-t { font-size: 1.15rem; }
    }
  </style>

  <script>
    type Item = { slug: string; titel: string; slash: string; gang: string };
    const data = JSON.parse(document.getElementById('kk-data')!.textContent || '{}') as { gangen: string[]; items: Item[] };
    const SLEUTEL = 'ode-kerstkaart';
    const lees = () => { try { return JSON.parse(localStorage.getItem(SLEUTEL) || '{}'); } catch { return {}; } };
    const bewaar = (v: object) => { try { localStorage.setItem(SLEUTEL, JSON.stringify(v)); } catch {} };

    const vakjes = Array.from(document.querySelectorAll<HTMLInputElement>('.kk-kies input'));
    const naam = document.getElementById('kk-naam') as HTMLInputElement;
    const dag = document.getElementById('kk-dag') as HTMLInputElement;
    const lijst = document.getElementById('kk-lijst')!;
    const titel = document.getElementById('kk-titel')!;
    const datum = document.getElementById('kk-datum')!;
    const knop = document.getElementById('kk-download') as HTMLButtonElement;
    const balk = document.querySelector<HTMLAnchorElement>('.kk-balk')!;
    const teller = document.getElementById('kk-teller')!;

    const opgeslagen = lees();
    if (Array.isArray(opgeslagen.keuze)) vakjes.forEach((v) => { v.checked = opgeslagen.keuze.includes(v.value); });
    if (typeof opgeslagen.naam === 'string') naam.value = opgeslagen.naam;
    if (typeof opgeslagen.dag === 'string') dag.value = opgeslagen.dag;

    const gekozen = (): Item[] => {
      const set = new Set(vakjes.filter((v) => v.checked).map((v) => v.value));
      return data.items.filter((i) => set.has(i.slug));
    };
    const titelTekst = () => naam.value.trim() || 'een ode aan kerst';

    const el = (tag: string, cls: string, tekst: string) => { const e = document.createElement(tag); e.className = cls; e.textContent = tekst; return e; };

    function teken() {
      const keuze = gekozen();
      titel.textContent = titelTekst();
      datum.textContent = dag.value.trim();
      lijst.replaceChildren();
      if (!keuze.length) {
        lijst.append(el('p', 'kk-leeg', 'Klik gerechten aan op de kaart. Ze verschijnen hier.'));
      } else {
        data.gangen.forEach((g) => {
          const items = keuze.filter((i) => i.gang === g);
          if (!items.length) return;
          const blok = el('div', 'kk-g', '');
          blok.append(el('p', 'kk-gl', g));
          items.forEach((i) => { blok.append(el('p', 'kk-gt', i.titel), el('p', 'kk-gs', i.slash)); });
          lijst.append(blok);
        });
      }
      data.gangen.forEach((g) => {
        const n = keuze.filter((i) => i.gang === g).length;
        const t = document.querySelector(`[data-aantal="${g}"]`);
        if (t) t.textContent = n ? `${n} gekozen` : '';
      });
      knop.disabled = !keuze.length;
      teller.textContent = `${keuze.length} ${keuze.length === 1 ? 'gerecht' : 'gerechten'}`;
      balk.hidden = !keuze.length;
      bewaar({ keuze: keuze.map((i) => i.slug), naam: naam.value, dag: dag.value });
      tekenVoorbeeld();
    }

    vakjes.forEach((v) => v.addEventListener('change', teken));
    naam.addEventListener('input', teken);
    dag.addEventListener('input', teken);
    document.getElementById('kk-wis')!.addEventListener('click', () => { vakjes.forEach((v) => { v.checked = false; }); teken(); });

    // Verberg de balk onderaan zodra het kaartje zelf in beeld is.
    const zij = document.getElementById('kaartje');
    if (zij && 'IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => { balk.style.visibility = e.isIntersecting ? 'hidden' : ''; }).observe(zij);
    }

    // ---------- KAARTJE (voorbeeld en PDF delen dezelfde tekening) ----------
    // Ontwerp "een ode aan kerst": bordeaux achtergrond, roomkleurige boog met gouden kader, dennenslinger en strik.
    const WIJN = '#51121a';
    const ZACHT = '#7b4a52';
    const GOUD = '#b08d57';
    const W = 1748, H = 2480; // A5 op 300 dpi
    const SERIF = '"Cormorant Garamond", Georgia, serif';
    const SANS = '"Jost", "Helvetica Neue", Arial, sans-serif';
    // Boog (in pixels van het A5 doek)
    const BL = 211, BR = 1532, BB = 2223, BS = 966; // links, rechts, onder, waar de boog begint
    const BM = (BL + BR) / 2, BRAD = (BR - BL) / 2;

    function laadBeeld(src: string): Promise<HTMLImageElement | null> {
      return new Promise((ok) => { const i = new Image(); i.onload = () => ok(i); i.onerror = () => ok(null); i.src = src; });
    }
    let beelden: Promise<{ slinger: HTMLImageElement | null; strik: HTMLImageElement | null }> | null = null;
    const laadBeelden = () => (beelden ??= Promise.all([laadBeeld('/fotos/kerst/slinger.webp'), laadBeeld('/fotos/kerst/strik.webp')]).then(([slinger, strik]) => ({ slinger, strik })));
    let fonts: Promise<unknown> | null = null;
    const laadFonts = () => (fonts ??= Promise.all([
      document.fonts.load(`300 60px ${SERIF}`),
      document.fonts.load(`italic 300 60px ${SERIF}`),
      document.fonts.load(`400 60px ${SERIF}`),
      document.fonts.load(`italic 400 60px ${SERIF}`),
      document.fonts.load(`300 30px ${SANS}`),
      document.fonts.load(`400 30px ${SANS}`),
    ]).catch(() => {}));

    function gespreid(ctx: CanvasRenderingContext2D, tekst: string, x: number, y: number, ruimte: number) {
      const tekens = Array.from(tekst);
      const breedte = tekens.reduce((s, t) => s + ctx.measureText(t).width, 0) + ruimte * (tekens.length - 1);
      let cx = x - breedte / 2;
      const oud = ctx.textAlign; ctx.textAlign = 'left';
      tekens.forEach((t) => { ctx.fillText(t, cx, y); cx += ctx.measureText(t).width + ruimte; });
      ctx.textAlign = oud;
    }

    function pasIn(ctx: CanvasRenderingContext2D, tekst: string, font: (px: number) => string, px: number, max: number) {
      ctx.font = font(px);
      let w = ctx.measureText(tekst).width;
      while (w > max && px > 10) { px -= 2; ctx.font = font(px); w = ctx.measureText(tekst).width; }
      return px;
    }

    // Titel: woorden met "kerst" erin komen cursief, zoals "een ode aan kerst".
    function tekenTitel(ctx: CanvasRenderingContext2D, tekst: string, y: number, max: number) {
      const delen = tekst.split(/(\s+)/).filter(Boolean).map((t) => ({ t, cursief: /kerst/i.test(t) }));
      const font = (px: number, c: boolean) => `${c ? 'italic ' : ''}300 ${px}px ${SERIF}`;
      const breedte = (px: number) => delen.reduce((s, d) => { ctx.font = font(px, d.cursief); return s + ctx.measureText(d.t).width; }, 0);
      let px = 112;
      while (breedte(px) > max && px > 30) px -= 2;
      let x = W / 2 - breedte(px) / 2;
      ctx.textAlign = 'left';
      delen.forEach((d) => { ctx.font = font(px, d.cursief); ctx.fillText(d.t, x, y); x += ctx.measureText(d.t).width; });
      ctx.textAlign = 'center';
    }

    function boogPad(ctx: CanvasRenderingContext2D, inset: number) {
      ctx.beginPath();
      ctx.moveTo(BL + inset, BB - inset);
      ctx.lineTo(BL + inset, BS);
      ctx.arc(BM, BS, BRAD - inset, Math.PI, 0);
      ctx.lineTo(BR - inset, BB - inset);
      ctx.closePath();
    }

    async function tekenKaart(c: HTMLCanvasElement): Promise<HTMLCanvasElement> {
      const [{ slinger, strik }] = await Promise.all([laadBeelden(), laadFonts()]);
      const schaal = c.width / W;
      const ctx = c.getContext('2d')!;
      ctx.setTransform(schaal, 0, 0, schaal, 0, 0);
      ctx.imageSmoothingQuality = 'high';

      // Achtergrond: bordeaux met zachte gloed bovenaan
      const bg = ctx.createRadialGradient(W / 2, H * .2, 0, W / 2, H * .45, H * .8);
      bg.addColorStop(0, '#4f111b'); bg.addColorStop(.55, '#3e0c15'); bg.addColorStop(1, '#22060b');
      ctx.fillStyle = bg; ctx.fillRect(0, 0, W, H);

      // Schaduw van de boog
      ctx.save();
      ctx.shadowColor = 'rgba(0,0,0,.45)'; ctx.shadowBlur = 60; ctx.shadowOffsetY = 30;
      ctx.translate(18, 18); boogPad(ctx, 0); ctx.fillStyle = '#1a0408'; ctx.fill();
      ctx.restore();

      // De boog zelf, room met een lichte verloop
      const room = ctx.createLinearGradient(0, BS - BRAD, 0, BB);
      room.addColorStop(0, '#f9f6f1'); room.addColorStop(1, '#efe7dd');
      boogPad(ctx, 0); ctx.fillStyle = room; ctx.fill();
      boogPad(ctx, 30); ctx.strokeStyle = GOUD; ctx.lineWidth = 3; ctx.stroke();

      // Slinger en strik
      ctx.save(); ctx.shadowColor = 'rgba(20,3,7,.35)'; ctx.shadowBlur = 14; ctx.shadowOffsetY = 8;
      if (slinger) ctx.drawImage(slinger, 90, 168, 1555, 1017);
      if (strik) ctx.drawImage(strik, 664, 202, 416, 477);
      ctx.restore();

      ctx.textAlign = 'center'; ctx.textBaseline = 'alphabetic';
      const MAXB = BR - BL - 200;

      // Titel, datum en sierlijn
      ctx.fillStyle = WIJN;
      tekenTitel(ctx, titelTekst(), 980, MAXB);
      const d = dag.value.trim();
      const lijnY = d ? 1135 : 1080;
      if (d) { ctx.fillStyle = WIJN; ctx.font = `300 ${pasIn(ctx, d.toUpperCase(), (px) => `300 ${px}px ${SANS}`, 25, MAXB - 200)}px ${SANS}`; gespreid(ctx, d.toUpperCase(), W / 2, 1056, 9); }
      ctx.strokeStyle = 'rgba(81,18,26,.5)'; ctx.lineWidth = 3;
      ctx.beginPath(); ctx.moveTo(W / 2 - 260, lijnY); ctx.lineTo(W / 2 - 40, lijnY); ctx.moveTo(W / 2 + 40, lijnY); ctx.lineTo(W / 2 + 260, lijnY); ctx.stroke();
      ctx.save(); ctx.translate(W / 2, lijnY); ctx.rotate(Math.PI / 4); ctx.fillStyle = WIJN; ctx.fillRect(-7, -7, 14, 14); ctx.restore();

      // Gerechten: alles schalen zodat het tussen de sierlijn en de voet past, desnoods in twee kolommen.
      const keuze = gekozen();
      const blokken = data.gangen.map((g) => ({ g, items: keuze.filter((i) => i.gang === g) })).filter((b) => b.items.length);
      const blokH = (b: { items: Item[] }, s: number) => 54 * s + b.items.reduce((h, _i, ii) => h + (ii ? 30 * s : 0) + 62 * s + 46 * s, 0);
      const kolomH = (lijst: typeof blokken, s: number) => lijst.reduce((h, b, bi) => h + (bi ? 84 * s : 0) + blokH(b, s), 0);
      const top = lijnY + 70, onder = 2030, ruimte = onder - top;

      let kolommen: (typeof blokken)[] = [blokken];
      let s = blokken.length ? Math.min(1, ruimte / kolomH(blokken, 1)) : 1;
      if (s < .62 && blokken.length > 1) {
        // Verdeel de gangen over twee kolommen met zo gelijk mogelijke hoogte.
        let best = 1, beste = Infinity;
        for (let k = 1; k < blokken.length; k++) {
          const h = Math.max(kolomH(blokken.slice(0, k), 1), kolomH(blokken.slice(k), 1));
          if (h < beste) { beste = h; best = k; }
        }
        kolommen = [blokken.slice(0, best), blokken.slice(best)];
        s = Math.min(.85, ruimte / beste);
      }
      const kolomB = kolommen.length > 1 ? (BR - BL - 180) / 2 : MAXB;
      const kolomX = kolommen.length > 1 ? [W / 2 - kolomB / 2 - 10, W / 2 + kolomB / 2 + 10] : [W / 2];

      const hoogste = Math.max(...kolommen.map((k) => kolomH(k, s)));
      kolommen.forEach((kol, ki) => {
        const x = kolomX[ki];
        let y = top + Math.max(0, (ruimte - hoogste) / 2);
        kol.forEach((b, bi) => {
          if (bi) y += 84 * s;
          ctx.fillStyle = WIJN; ctx.font = `400 ${Math.round(22 * s)}px ${SANS}`;
          y += 22 * s;
          gespreid(ctx, b.g.toUpperCase(), x, y, 8 * s);
          y += 32 * s;
          b.items.forEach((i, ii) => {
            if (ii) y += 30 * s;
            ctx.fillStyle = WIJN;
            pasIn(ctx, i.titel, (px) => `400 ${px}px ${SERIF}`, Math.round(58 * s), kolomB);
            y += 58 * s; ctx.fillText(i.titel, x, y); y += 4 * s;
            ctx.fillStyle = ZACHT;
            pasIn(ctx, i.slash, (px) => `italic 400 ${px}px ${SERIF}`, Math.round(38 * s), kolomB);
            y += 42 * s; ctx.fillText(i.slash, x, y);
          });
        });
      });
      if (!blokken.length) {
        ctx.fillStyle = 'rgba(81,18,26,.55)'; ctx.font = `italic 400 44px ${SERIF}`;
        ctx.fillText('kies je gerechten op de kaart', W / 2, top + ruimte / 2 - 20);
        ctx.fillText('en ze verschijnen hier', W / 2, top + ruimte / 2 + 40);
      }

      // Voet in de boog en onder de boog
      ctx.fillStyle = 'rgba(81,18,26,.5)'; ctx.font = `300 21px ${SANS}`;
      gespreid(ctx, 'KERST MET ODE  ·  ODECUISINE.BE', W / 2, 2112, 9);
      ctx.fillStyle = '#f4ece3'; ctx.font = `italic 300 46px ${SERIF}`;
      ctx.fillText('Smaken die je nooit echt vergeet.', W / 2, 2318);
      ctx.fillStyle = 'rgba(244,236,227,.72)'; ctx.font = `italic 300 33px ${SERIF}`;
      ctx.fillText('ode cuisine.', W / 2, 2380);
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      return c;
    }

    // Live voorbeeld naast de kaart
    const doek = document.getElementById('kk-doek') as HTMLCanvasElement;
    let bezig = false, opnieuw = false;
    async function tekenVoorbeeld() {
      if (bezig) { opnieuw = true; return; }
      bezig = true;
      try { await tekenKaart(doek); } finally { bezig = false; }
      if (opnieuw) { opnieuw = false; tekenVoorbeeld(); }
    }
    teken();
    document.fonts?.ready.then(() => tekenVoorbeeld());

    // Minimale PDF met één JPEG op een A5 pagina.
    function maakPdf(jpeg: Uint8Array, bw: number, bh: number): Blob {
      const enc = new TextEncoder();
      const delen: Uint8Array[] = [];
      const offsets: number[] = [];
      let lengte = 0;
      const voeg = (d: Uint8Array | string) => { const b = typeof d === 'string' ? enc.encode(d) : d; delen.push(b); lengte += b.length; };
      const pw = 419.53, ph = 595.28;
      const inhoud = `q ${pw} 0 0 ${ph} 0 0 cm /Im0 Do Q`;
      voeg('%PDF-1.4\n%\xE2\xE3\xCF\xD3\n');
      offsets[1] = lengte; voeg('1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n');
      offsets[2] = lengte; voeg('2 0 obj\n<< /Type /Pages /Kids [3 0 R] /Count 1 >>\nendobj\n');
      offsets[3] = lengte; voeg(`3 0 obj\n<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${pw} ${ph}] /Resources << /XObject << /Im0 4 0 R >> >> /Contents 5 0 R >>\nendobj\n`);
      offsets[4] = lengte; voeg(`4 0 obj\n<< /Type /XObject /Subtype /Image /Width ${bw} /Height ${bh} /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length ${jpeg.length} >>\nstream\n`);
      voeg(jpeg); voeg('\nendstream\nendobj\n');
      offsets[5] = lengte; voeg(`5 0 obj\n<< /Length ${inhoud.length} >>\nstream\n${inhoud}\nendstream\nendobj\n`);
      const xref = lengte;
      let x = 'xref\n0 6\n0000000000 65535 f \n';
      for (let i = 1; i <= 5; i++) x += String(offsets[i]).padStart(10, '0') + ' 00000 n \n';
      voeg(x + `trailer\n<< /Size 6 /Root 1 0 R /Info << /Title (Menukaartje Ode Cuisine) /Creator (odecuisine.be) >> >>\nstartxref\n${xref}\n%%EOF\n`);
      return new Blob(delen, { type: 'application/pdf' });
    }

    knop.addEventListener('click', async () => {
      if (!gekozen().length) return;
      const tekst = knop.innerHTML;
      knop.disabled = true; knop.textContent = 'Even je kaartje drukken…';
      try {
        const c = document.createElement('canvas'); c.width = W; c.height = H;
        await tekenKaart(c);
        const blob: Blob = await new Promise((ok) => c.toBlob((b) => ok(b!), 'image/jpeg', 0.92));
        const pdf = maakPdf(new Uint8Array(await blob.arrayBuffer()), W, H);
        const url = URL.createObjectURL(pdf);
        const a = document.createElement('a');
        const bestand = titelTekst().toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'kerstmenu';
        a.href = url; a.download = `menukaartje-${bestand}-ode-cuisine.pdf`;
        document.body.append(a); a.click(); a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 10000);
        if (typeof (window as any).gtag === 'function') (window as any).gtag('event', 'kerst_menukaartje', { aantal: gekozen().length });
      } finally {
        knop.innerHTML = tekst; knop.disabled = !gekozen().length;
      }
    });
  </script>
