---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  schema?: object | object[];
  image?: string;
}
const { title, description, schema, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === 'Ode Cuisine' ? 'Ode Cuisine · Een ode aan de recepten die ons hebben grootgebracht' : `${title} · Ode Cuisine`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Ode Cuisine',
  url: 'https://www.odecuisine.be',
  logo: 'https://www.odecuisine.be/logo/ode-o.png',
  slogan: 'Een ode aan de recepten die ons hebben grootgebracht.',
  founder: [
    { '@type': 'Person', name: 'Florry Kindt' },
    { '@type': 'Person', name: 'Gilles' },
  ],
  areaServed: ['Oost-Vlaanderen', 'West-Vlaanderen'],
};
const schemas = [orgSchema, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
const pad = Astro.url.pathname;
const huidig = (p: string) => (pad.startsWith(p) ? 'page' : undefined);
---
<!doctype html>
<html lang="nl-BE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#51121a" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_BE" />
    <meta property="og:image" content={new URL(image ?? '/logo/ode-o.png', Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Jost:wght@300;400&display=swap" rel="stylesheet" />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <!-- Google Analytics 4 met Consent Mode: standaard geen cookies tot de bezoeker akkoord geeft -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      var odeKeuze = null;
      try { odeKeuze = localStorage.getItem('ode-cookies'); } catch (e) {}
      gtag('consent', 'default', {
        ad_storage: odeKeuze === 'ja' ? 'granted' : 'denied',
        ad_user_data: odeKeuze === 'ja' ? 'granted' : 'denied',
        ad_personalization: odeKeuze === 'ja' ? 'granted' : 'denied',
        analytics_storage: odeKeuze === 'ja' ? 'granted' : 'denied',
        wait_for_update: 500
      });
      gtag('js', new Date());
      gtag('config', 'G-88NY39C14N');
      // Meta pixel: wordt pas geladen na Akkoord in de cookiebanner
      window.odeLaadPixel = function(){
        if (window.fbq) return;
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '1110433621482917');
        fbq('track', 'PageView');
      };
      if (odeKeuze === 'ja') window.odeLaadPixel();
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-88NY39C14N"></script>
  </head>
  <body class={Astro.url.pathname === "/" ? "home" : undefined}>
    <header class="kop">
      <a class="hoek hoek-lb" href="/recepten/" aria-current={huidig('/recepten')}>recepten</a>
      <a class="logo" href="/" aria-label="Ode Cuisine, naar de homepage">
        <span class="o-mark" aria-hidden="true"></span><span class="logo-naam">ode cuisine.</span>
      </a>
      <a class="hoek hoek-rb hoek-knop" href="/aan-tafel/" aria-current={huidig('/aan-tafel')}>aan tafel</a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="nav-mobiel">menu</button>
    </header>
    <a class="hoek hoek-lo" href="/verhaal/" aria-current={huidig('/verhaal')}>het verhaal</a>
    <a class="hoek hoek-ro" href="/kookboek/" aria-current={huidig('/kookboek')}>kookboek</a>
    <nav class="nav-mobiel" id="nav-mobiel" aria-label="Mobiel menu">
      <a href="/">Home</a>
      <a href="/recepten/">Recepten</a>
      <a href="/verhaal/">Het verhaal</a>
      <a href="/aan-tafel/">Aan tafel</a>
      <a href="/kookboek/">Kookboek</a>
    </nav>

    <main><slot /></main>

    <footer class="voet">
      <div class="voet-o" aria-hidden="true"><span class="o-mark"></span></div>
      <div class="wrap">
        <div>
          <p class="groot">Smaken die je <em>nooit</em> echt vergeet.</p>
          <p>Private dining aan huis in Oost en West-Vlaanderen, door Florry en Gilles. Elke zondag een nieuw recept.</p>
        </div>
        <div>
          <a href="/recepten/">Recepten</a>
          <a href="/aan-tafel/">Aan tafel</a>
          <a href="/verhaal/">Het verhaal</a>
          <a href="/kookboek/">Kookboek</a>
          <a href="/het-schriftje/">Het schriftje</a>
        </div>
        <div>
          <a href="https://www.instagram.com/" rel="noopener">Instagram</a>
          <a href="https://www.pinterest.com/" rel="noopener">Pinterest</a>
          <a href="/aan-tafel/#aanvraag">Contact</a>
        </div>
        <p class="klein">© {new Date().getFullYear()} Ode Cuisine · www.odecuisine.be · <span class="credit">Ontwerp en website door <a href="https://www.flowyagency.com" target="_blank" rel="noopener">Flowy</a></span> · <button type="button" class="cookie-link" data-cookie-open>Cookies</button></p>
      </div>
    </footer>

    <div class="cookie-banner" id="cookie-banner" role="dialog" aria-live="polite" aria-label="Cookies" hidden>
      <p>We gebruiken cookies om te zien hoe je bij ons terechtkomt en om onze advertenties op Facebook en Instagram beter te maken. Is dat oké?</p>
      <div class="cookie-knoppen">
        <button type="button" class="cookie-nee" data-cookie="nee">Liever niet</button>
        <button type="button" class="cookie-ja" data-cookie="ja">Akkoord</button>
      </div>
    </div>
    <style is:inline>
      .cookie-banner{position:fixed;left:16px;right:16px;bottom:16px;z-index:9999;max-width:460px;margin-left:auto;background:#f6efe6;color:#51121a;border:1px solid rgba(81,18,26,.25);padding:18px 20px;border-radius:14px;font-family:'Jost',sans-serif;font-weight:300;font-size:15px;line-height:1.5;box-shadow:0 10px 30px rgba(0,0,0,.25)}
      .cookie-banner[hidden]{display:none}
      .cookie-banner p{margin:0 0 14px}
      .cookie-knoppen{display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap}
      .cookie-knoppen button{font:inherit;font-weight:400;cursor:pointer;border-radius:999px;padding:8px 18px;border:1px solid #51121a}
      .cookie-nee{background:transparent;color:#51121a}
      .cookie-ja{background:#51121a;color:#f6efe6}
      .cookie-link{background:none;border:0;padding:0;font:inherit;color:inherit;text-decoration:underline;cursor:pointer}
    </style>
    <script is:inline>
      (function(){
        var b = document.getElementById('cookie-banner');
        var keuze = null;
        try { keuze = localStorage.getItem('ode-cookies'); } catch (e) {}
        if (!keuze) b.hidden = false;
        document.querySelectorAll('[data-cookie]').forEach(function(k){
          k.addEventListener('click', function(){
            var v = k.getAttribute('data-cookie');
            try { localStorage.setItem('ode-cookies', v); } catch (e) {}
            var g = v === 'ja' ? 'granted' : 'denied';
            gtag('consent', 'update', { analytics_storage: g, ad_storage: g, ad_user_data: g, ad_personalization: g });
            if (v === 'ja') window.odeLaadPixel(); else if (window.fbq) fbq('consent', 'revoke');
            b.hidden = true;
          });
        });
        document.querySelectorAll('[data-cookie-open]').forEach(function(k){
          k.addEventListener('click', function(){ b.hidden = false; });
        });
      })();
    </script>

    <script>
      import Lenis from 'lenis';

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // zacht scrollen
      if (!reduce) {
        const lenis = new Lenis({ lerp: 0.09 });
        const raf = (t: number) => { lenis.raf(t); requestAnimationFrame(raf); };
        requestAnimationFrame(raf);
      }

      // intro animaties starten
      requestAnimationFrame(() => setTimeout(() => document.body.classList.add('geladen'), 80));

      // header: kleiner na scrollen, verstopt bij naar beneden scrollen
      const kop = document.querySelector('.kop')!;
      let vorige = 0;
      const opScroll = () => {
        const y = window.scrollY;
        kop.classList.toggle('klein', y > 40);
        kop.classList.toggle('weg', y > 400 && y > vorige);
        vorige = y;
      };
      window.addEventListener('scroll', opScroll, { passive: true }); opScroll();

      // elementen laten verschijnen bij scrollen
      const io = new IntersectionObserver((items) => items.forEach((i) => {
        if (i.isIntersecting) { i.target.classList.add('zichtbaar'); io.unobserve(i.target); }
      }), { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('[data-stagger]').forEach((g) => {
        Array.from(g.children).forEach((c, i) => (c as HTMLElement).style.setProperty('--i', String(i)));
      });
      document.querySelectorAll('.reveal, .reveal-foto').forEach((el) => io.observe(el));
      document.querySelectorAll('main .sectie h2, main .sectie > .wrap > p, main .smal > p, main .kaart, main .formule, main .faq, main .cta-kader, main .gerecht-rij').forEach((el) => {
        if (el.closest('.hero') || el.classList.contains('reveal')) return;
        el.classList.add('reveal'); io.observe(el);
      });

      // parallax op elementen met data-snelheid
      const para = document.querySelectorAll<HTMLElement>('[data-snelheid]');
      if (!reduce && para.length) {
        const tik = () => {
          para.forEach((el) => {
            const r = el.getBoundingClientRect();
            const mid = r.top + r.height / 2 - window.innerHeight / 2;
            el.style.translate = `0 ${mid * Number(el.dataset.snelheid)}px`;
          });
          requestAnimationFrame(tik);
        };
        tik();
      }

      // achtergrondkleur van de pagina vloeit mee met de sectie in beeld
      // pagina's zonder eigen kleurinstelling: afleiden uit de sectieklasse
      if (!document.querySelector('[data-kleur]')) {
        document.querySelectorAll<HTMLElement>('main > section').forEach((s) => {
          s.dataset.kleur = s.classList.contains('sectie--wijn') ? 'wijn' : s.classList.contains('sectie--zand') || s.classList.contains('sectie--room') ? 'room' : 'zand';
        });
      }
      const kleurSecties = document.querySelectorAll<HTMLElement>('[data-kleur]');
      if (kleurSecties.length) {
        document.body.dataset.kleur = kleurSecties[0].dataset.kleur;
        const kio = new IntersectionObserver((items) => items.forEach((i) => {
          if (i.isIntersecting) document.body.dataset.kleur = (i.target as HTMLElement).dataset.kleur;
        }), { rootMargin: '-50% 0px -50% 0px' });
        kleurSecties.forEach((s) => kio.observe(s));
      }

      // mobiel menu
      const t = document.querySelector('.menu-toggle');
      const n = document.getElementById('nav-mobiel');
      t?.addEventListener('click', () => {
        const open = n?.classList.toggle('open');
        t.setAttribute('aria-expanded', String(!!open));
        t.textContent = open ? 'Sluit' : 'Menu';
      });
    </script>
  </body>
</html>
