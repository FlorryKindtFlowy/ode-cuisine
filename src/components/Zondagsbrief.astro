---
// Inschrijfblok voor de nieuwsbrief Ode Zondag. Staat op elke pagina, net boven de footer.
// Het formulier stuurt naar /api/inschrijven (functions/api/inschrijven.js op Cloudflare).
// Na het inschrijven wordt er een plekje aan tafel gedekt, met de naam op een naamkaartje.
---
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&display=swap" />

<section class="zondagsbrief" id="zondagsbrief">
  <div class="wrap zb-grid">
    <div class="zb-tekst">
      <span class="kicker">Ode Zondag · elke zondag om 9u</span>
      <h2>Schuif aan op <em>zondag</em></h2>
      <p>Aan tafel bij Ode is er altijd een stoel vrij. Elke zondagochtend dekken we een plekje voor jou: één recept, het verhaal van de persoon erachter en alles wat je nodig hebt om het zelf op tafel te zetten.</p>
    </div>

    <div class="zb-podium">
      <form class="zb-form" action="/api/inschrijven" method="post" data-zondagsbrief>
        <label class="zb-veld">
          <span>Hoe mogen we je noemen?</span>
          <input type="text" name="voornaam" autocomplete="given-name" maxlength="40" placeholder="je voornaam" />
        </label>
        <label class="zb-veld">
          <span>Waar mag het recept naartoe?</span>
          <input type="email" name="email" autocomplete="email" required placeholder="je e-mailadres" />
        </label>
        <input class="zb-val" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="knop zb-knop" type="submit"><span>Dek een plekje voor mij</span></button>
        <p class="zb-klein">Eén mail per week, geen reclame. Uitschrijven kan altijd, met één klik.</p>
        <p class="zb-fout" role="alert"></p>
      </form>

      <div class="zb-tafel" aria-live="polite" hidden>
        <div class="zb-setting" aria-hidden="true">
          <span class="zb-vork"></span>
          <div class="zb-bord">
            <svg viewBox="0 0 200 200"><circle cx="100" cy="100" r="96" /><circle cx="100" cy="100" r="70" /></svg>
            <span class="o-mark zb-o"></span>
          </div>
          <span class="zb-mes"></span>
          <span class="zb-glas"></span>
        </div>
        <div class="zb-kaartje">
          <span class="zb-kaartje-label">gereserveerd voor</span>
          <span class="zb-naam" data-naam>jou</span>
        </div>
        <div class="zb-strooisel" aria-hidden="true"></div>
        <p class="zb-bedankt"><em>Je plekje is gedekt.</em> Zondag om 9u ligt je eerste recept klaar. Kijk ook even in je mailbox, er wacht al een welkom.</p>
        <p class="zb-tot">Tot sebiet.</p>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-zondagsbrief]');
  const tafel = document.querySelector<HTMLElement>('.zb-tafel');
  if (form && tafel) {
    const fout = form.querySelector('.zb-fout') as HTMLElement;
    const knop = form.querySelector('button') as HTMLButtonElement;
    const knopTekst = knop.querySelector('span') as HTMLElement;
    const naamVeld = tafel.querySelector('[data-naam]') as HTMLElement;
    const strooi = tafel.querySelector('.zb-strooisel') as HTMLElement;

    const dek = (naam: string) => {
      naamVeld.textContent = naam || 'jou';
      // een handvol peterselie en peperkorrels
      strooi.innerHTML = '';
      for (let i = 0; i < 22; i++) {
        const s = document.createElement('i');
        s.className = i % 3 ? 'blad' : 'korrel';
        s.style.setProperty('--x', `${Math.random() * 100}%`);
        s.style.setProperty('--d', `${(Math.random() * 0.9).toFixed(2)}s`);
        s.style.setProperty('--r', `${Math.round(Math.random() * 360)}deg`);
        s.style.setProperty('--val', `${120 + Math.random() * 160}px`);
        strooi.appendChild(s);
      }
      form.classList.add('weg');
      setTimeout(() => {
        form.hidden = true;
        tafel.hidden = false;
        requestAnimationFrame(() => tafel.classList.add('gedekt'));
      }, 450);
    };

    if (location.search.includes('zondag=ingeschreven')) dek('');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      fout.textContent = '';
      knop.disabled = true;
      knopTekst.textContent = 'Even dekken…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const data = await res.json();
        if (data.ok) {
          (window as any).gtag?.('event', 'sign_up', { method: 'ode_zondag' });
          dek(String(new FormData(form).get('voornaam') || '').trim());
          return;
        }
        fout.textContent = data.bericht;
      } catch {
        fout.textContent = 'Er ging iets mis. Probeer je het straks nog eens?';
      }
      knop.disabled = false;
      knopTekst.textContent = 'Dek een plekje voor mij';
    });
  }
</script>

<style>
  .zondagsbrief { background: var(--room); color: var(--inkt); padding: clamp(80px, 11vw, 140px) 0; position: relative; z-index: 1; overflow: hidden; }
  .zondagsbrief .kicker { color: var(--zacht); }
  .zondagsbrief h2 { color: var(--inkt); margin-bottom: .4em; }
  .zondagsbrief h2 em { color: var(--wijn); }
  .zb-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(36px, 7vw, 110px); align-items: center; }
  .zb-tekst p { color: var(--zacht); max-width: 31em; }
  .zb-podium { position: relative; min-height: 380px; display: grid; align-items: center; }

  /* formulier */
  .zb-form { display: grid; gap: 22px; transition: opacity .45s var(--ease), transform .45s var(--ease); }
  .zb-form[hidden], .zb-tafel[hidden] { display: none; }
  .zb-form.weg { opacity: 0; transform: translateY(-14px) scale(.98); }
  .zb-veld { display: grid; gap: 4px; }
  .zb-veld span { font-family: var(--serif); font-style: italic; font-size: 1.25rem; color: var(--wijn); }
  .zb-veld input {
    font: inherit; font-size: 1.05rem; color: var(--inkt); background: transparent;
    border: 0; border-bottom: 1px solid var(--lijn); padding: 10px 0; border-radius: 0;
    transition: border-color .3s;
  }
  .zb-veld input::placeholder { color: rgba(79,61,74,.45); }
  .zb-veld input:focus { outline: none; border-bottom-color: var(--wijn); }
  .zb-val { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .zb-knop { justify-self: start; margin-top: 4px; cursor: pointer; }
  .zb-knop:disabled { opacity: .7; cursor: wait; }
  .zb-klein { font-size: .82rem; margin: 0; color: var(--zacht); }
  .zb-fout { margin: 0; font-family: var(--serif); font-style: italic; font-size: 1.2rem; color: var(--wijn); min-height: 1em; }

  /* de gedekte tafel */
  .zb-tafel { position: relative; text-align: center; padding: 10px 0; }
  .zb-setting { position: relative; width: min(340px, 82%); margin: 0 auto; aspect-ratio: 1.55; display: flex; align-items: center; justify-content: center; }
  .zb-bord { position: relative; width: 58%; display: grid; place-items: center; transform: scale(.6) rotate(-90deg); opacity: 0; transition: transform 1s var(--ease), opacity .6s; }
  .zb-bord svg { width: 100%; display: block; }
  .zb-bord .zb-o { position: absolute; width: 24%; color: var(--wijn); }
  .zb-bord circle { fill: var(--creme); stroke: var(--wijn); stroke-width: 1.2; }
  .zb-bord circle + circle { fill: none; stroke: var(--lijn); }
  .zb-bord .zb-o { opacity: 0; transition: opacity .8s .9s; }
  .zb-vork, .zb-mes { position: absolute; top: 18%; height: 64%; width: 7px; border-radius: 4px; background: var(--wijn); opacity: 0; transition: transform .8s var(--ease) .35s, opacity .5s .35s; }
  .zb-vork { left: 8%; transform: translateX(-60px); background: linear-gradient(90deg, var(--wijn) 0 1.5px, transparent 1.5px 2.75px, var(--wijn) 2.75px 4.25px, transparent 4.25px 5.5px, var(--wijn) 5.5px) top / 100% 26% no-repeat, linear-gradient(var(--wijn), var(--wijn)) center 0 / 3px 100% no-repeat; }
  .zb-mes { right: 8%; transform: translateX(60px); width: 6px; border-radius: 6px 1px 3px 3px; }
  .zb-glas { position: absolute; top: 2%; right: 0; width: 34px; height: 34px; border-radius: 50%; border: 1.2px solid var(--wijn); background: rgba(81,18,26,.08); opacity: 0; transform: translateY(-20px); transition: transform .7s var(--ease) .6s, opacity .5s .6s; }

  .zb-kaartje {
    position: relative; display: inline-flex; flex-direction: column; gap: 2px;
    margin: -8px auto 0; padding: 14px 34px 12px; min-width: 190px;
    background: var(--creme); border: 1px solid rgba(81,18,26,.3);
    box-shadow: 0 14px 30px -18px rgba(42,10,16,.5);
    transform-origin: 50% 100%; transform: perspective(500px) rotateX(-92deg); opacity: 0;
    transition: transform .9s cubic-bezier(.3,1.5,.5,1) 1.1s, opacity .2s 1.1s;
  }
  .zb-kaartje::before { content: ''; position: absolute; left: 10px; right: 10px; top: 6px; border-top: 1px solid rgba(81,18,26,.15); }
  .zb-kaartje-label { font-size: .64rem; letter-spacing: .26em; text-transform: uppercase; color: var(--zacht); }
  .zb-naam {
    font-family: 'Caveat', cursive; font-size: 2.6rem; line-height: 1.05; color: var(--wijn);
    clip-path: inset(0 100% 0 0); transition: clip-path 1.3s steps(14, end) 1.9s;
  }
  .zb-bedankt { margin: 30px auto 4px; max-width: 26em; color: var(--zacht); opacity: 0; transform: translateY(10px); transition: all .8s var(--ease) 2.6s; }
  .zb-bedankt em { font-family: var(--serif); font-size: 1.45rem; color: var(--wijn); display: block; margin-bottom: 4px; }
  .zb-tot { font-family: 'Caveat', cursive; font-size: 1.6rem; color: var(--wijn); margin: 0; opacity: 0; transition: opacity .8s 3.1s; }

  .zb-tafel.gedekt .zb-bord { transform: none; opacity: 1; }
  .zb-tafel.gedekt .zb-bord .zb-o { opacity: 1; }
  .zb-tafel.gedekt .zb-vork, .zb-tafel.gedekt .zb-mes { transform: none; opacity: 1; }
  .zb-tafel.gedekt .zb-glas { transform: none; opacity: 1; }
  .zb-tafel.gedekt .zb-kaartje { transform: perspective(500px) rotateX(0); opacity: 1; }
  .zb-tafel.gedekt .zb-naam { clip-path: inset(0 0 0 0); }
  .zb-tafel.gedekt .zb-bedankt { opacity: 1; transform: none; }
  .zb-tafel.gedekt .zb-tot { opacity: 1; }

  /* peterselie en peper die over de tafel dwarrelen */
  .zb-strooisel { position: absolute; inset: -40px 0 0; pointer-events: none; overflow: visible; }
  .zb-strooisel i { position: absolute; top: 0; left: var(--x); opacity: 0; }
  .zb-strooisel .blad { width: 9px; height: 5px; border-radius: 9px 0; background: #5d6b3a; }
  .zb-strooisel .korrel { width: 4px; height: 4px; border-radius: 50%; background: var(--inkt); }
  .zb-tafel.gedekt .zb-strooisel i { animation: dwarrel 1.9s var(--ease) calc(1s + var(--d)) forwards; }
  @keyframes dwarrel {
    0% { opacity: 0; transform: translateY(-20px) rotate(0); }
    15% { opacity: 1; }
    80% { opacity: 1; }
    100% { opacity: 0; transform: translateY(var(--val)) rotate(var(--r)); }
  }

  @media (max-width: 820px) {
    .zb-grid { grid-template-columns: 1fr; }
    .zb-podium { min-height: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .zb-tafel *, .zb-form { transition: none !important; animation: none !important; }
  }
</style>
